# Copy to .env and adjust as needed. No real secrets belong in this file.

# --- Postgres ---
# POSTGRES_HOST/PORT below are for IN-CONTAINER clients (the processor
# service talking to "postgres:5432" over the Docker network). If you're
# running host-side tooling (alembic, psql, a local script) against the
# Dockerized Postgres, connect to localhost:${POSTGRES_HOST_PORT} instead --
# see docker-compose.yml for why host port 5432 itself is avoided.
POSTGRES_USER=pulseops
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=pulseops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=55432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_RAW_TELEMETRY_TOPIC=otel.raw.v1
KAFKA_DLQ_TOPIC=otel.dlq.v1

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_COLLECTOR_HTTP_ENDPOINT=http://otel-collector:4318

# --- Demo service ports (host side) ---
GATEWAY_PORT=8000
ORDERS_PORT=8001
PAYMENTS_PORT=8002

# --- Management API (phase 4) ---
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Optional AI enrichment (phase 4, optional) ---
# Leave unset to use the non-LLM fallback summarizer.
LLM_API_KEY=
LLM_MODEL=
